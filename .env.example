# Copy this file to `.env` and fill in the value.
#
# Web3Forms access key — powers the contact form. Get a free key at
# https://web3forms.com (enter brandoriv.dev@gmail.com); submissions are
# emailed straight to that inbox. The key is a public token by design.
PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Secret bearer token for https://brandoriv.dev/mcp.
# Set this in Cloudflare with: bunx wrangler secret put MCP_BEARER_TOKEN
MCP_BEARER_TOKEN=generate-a-long-random-token

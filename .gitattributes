# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ico binary

# Record indexes are generated between markers; duplicate lines beat lost links,
# and "bun run changes:index" cleans them up.
**/changes/README.md merge=union

{
  // Azure hosts Ledger; the Worker preserves its private /ledger route on this domain.
  "name": "brandoriv-dev",
  "main": "./mcp/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Ledger Function App in rg-ledger; deployed 2026-09-21 (see hosting/cloudflare/changes/2026-09-21-ledger-proxy-plan.md).
    "LEDGER_ORIGIN": "https://func-ledger-56d29fa3500e.azurewebsites.net"
  },
  "routes": [
    {
      // The MCP server is retired; the Worker answers /mcp* with a 410 tombstone.
      "pattern": "brandoriv.dev/mcp*",
      "zone_name": "brandoriv.dev"
    },
    {
      "pattern": "brandoriv.dev/ledger*",
      "zone_name": "brandoriv.dev"
    },
    {
      "pattern": "brandoriv.dev/moss*",
      "zone_name": "brandoriv.dev"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*", "/ledger", "/ledger/*", "/moss", "/moss/*"]
  }
}

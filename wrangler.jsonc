{
  // Azure hosts Harness and Ledger; the Worker preserves their private /harness and /ledger routes on this domain.
  "name": "brandoriv-dev",
  "main": "./mcp/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  // Dashboard sign-in with a personal Microsoft account. MICROSOFT_CLIENT_SECRET is
  // a Cloudflare secret (`wrangler secret put`), never a var. Only listed addresses
  // are granted a session; anyone else who signs in at Microsoft is refused.
  "vars": {
    "MCP_RETIRED": "true",
    "MICROSOFT_CLIENT_ID": "e9532d95-f974-4d3e-87d3-df451284981c",
    "DASHBOARD_ALLOWED_EMAILS": "brandoriv.dev@gmail.com",
    "HARNESS_ORIGIN": "https://func-harness-46a2966d0128.azurewebsites.net",
    // Ledger Function App in rg-ledger; deployed 2026-09-21 (see mcp/changes/2026-09-21-ledger-proxy-plan.md).
    "LEDGER_ORIGIN": "https://func-ledger-56d29fa3500e.azurewebsites.net",
    // Jev stays shadow-only until evals prove it should influence routing.
    // TYPESAFE_API_KEY and BSTACK_TOOLS_EVENT_TOKEN are secrets, not vars.
    "JEV_ROUTING_MODE": "off",
    "JEV_ROUTE_THRESHOLD": "0.65",
    "JEV_SEND_RAW_TASK": "0",
    "JEV_TIMEOUT_MS": "1500",
    "TYPESAFE_ENDPOINT": "https://api.typesafe.ai/v1/systemone",
    "TYPESAFE_MODEL": "jev-latest",
    "BSTACK_TOOLS_EVENT_ENDPOINT": "https://bstack.tools/api/v0/feedback"
  },
  "routes": [
    {
      "pattern": "brandoriv.dev/mcp*",
      "zone_name": "brandoriv.dev"
    },
    {
      "pattern": "brandoriv.dev/harness*",
      "zone_name": "brandoriv.dev"
    },
    {
      "pattern": "brandoriv.dev/ledger*",
      "zone_name": "brandoriv.dev"
    },
    {
      "pattern": "brandoriv.dev/moss*",
      "zone_name": "brandoriv.dev"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  // Wrangler auto-provisions this namespace on the next authenticated deploy.
  // Policy versions are immutable records; active:<id> is the only moving pointer.
  "kv_namespaces": [
    {
      "binding": "MCP_POLICIES"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*", "/harness", "/harness/*", "/ledger", "/ledger/*", "/moss", "/moss/*"]
  }
}

{
  "name": "brandoriv-dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run moss:live && bun run worker:check && bun run harness:test && astro check && astro build",
    "moss:check": "node mcp/moss-catalog-check.mjs",
    "moss:live": "node mcp/moss-catalog-check.mjs --against-live",
    "moss:test": "node mcp/moss-catalog-test.mjs",
    "harness:test": "node mcp/harness-test.mjs",
    "deploy": "bun run build && wrangler deploy",
    "worker:check": "tsc --noEmit -p mcp/tsconfig.json",
    "routes:smoke": "node mcp/route-smoke.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "changes:lint": "node scripts/changes-lint.mjs",
    "changes:index": "node scripts/changes-lint.mjs --index",
    "changes:test": "node scripts/changes-lint-test.mjs",
    "workspace:test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/workspace-manager.tests.ps1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bitter": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/permanent-marker": "^5.2.7",
    "astro": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  }
}

{
  "name": "brandoriv-dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run mcp:check && bun run mcp:dashboard-test && bun run mcp:routing-test && bun run mcp:policy-eval && astro check && astro build",
    "deploy": "bun run build && wrangler deploy",
    "mcp:check": "tsc --noEmit -p mcp/tsconfig.json",
    "mcp:dashboard-test": "node mcp/dashboard-test.mjs",
    "mcp:policy-eval": "node mcp/policy-eval.mjs",
    "mcp:rebaseline": "node mcp/rebaseline.mjs",
    "mcp:routing-test": "node mcp/routing-test.mjs",
    "mcp:smoke": "node mcp/smoke.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bitter": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/permanent-marker": "^5.2.7",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "astro": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  }
}

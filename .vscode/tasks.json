{
  "version": "2.0.0",
  "tasks": [
    {
      // Starts `bun run dev` (astro dev → http://localhost:4321) as a background
      // task. The launch configs wait for the "ready" line before opening a browser.
      "label": "dev server",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in|Local|watching for file changes"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}

---
import "@fontsource-variable/ibm-plex-sans/index.css";
import "@fontsource-variable/bitter/wght.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";

const assetVersion = "3.1.0";
const mossVersion = "v0.1.0-cb75ab0";
---

<!doctype html>
<html lang="en" data-concept="c">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1d201f" />
    <meta name="description" content="Private operational dashboard for Brandon Rivera's personal MCP server." />
    <link rel="icon" type="image/png" sizes="192x192" href="/mcp/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/mcp/manifest.webmanifest" />
    <script src={`/mcp/theme.js?v=${assetVersion}`} is:inline></script>
    <link rel="stylesheet" href={`/mcp/moss/${mossVersion}/tokens.css`} />
    <link rel="stylesheet" href={`/mcp/moss/${mossVersion}/styles.css`} />
    <link rel="stylesheet" href={`/mcp/dashboard.css?v=${assetVersion}`} />
    <title>Bullfrog | Personal MCP Console</title>
    <script type="module" src={`/mcp/moss-theme.js?v=${assetVersion}`} is:inline></script>
    <script type="module" src={`/mcp/moss/${mossVersion}/moss.js`} is:inline></script>
    <script src={`/mcp/dashboard.js?v=${assetVersion}`} defer is:inline></script>
  </head>
  <body data-authenticated="false">
    <div class="console-shell moss-app-shell" id="dashboard-app" aria-busy="true" inert>
      <moss-rail class="sidebar" id="sidebar" persist-key="brandoriv-mcp-rail" collapsed>
        <div class="rail-header" data-rail-header>
          <a class="brand" href="/" aria-label="Bullfrog home — return to brandoriv.dev">
            <img src="/mcp/brandoriv-mcp-icon.png" alt="" width="34" height="34" />
            <span data-rail-title>
              <strong>Bullfrog</strong>
              <small>Personal MCP</small>
            </span>
          </a>
          <button class="rail-toggle moss-button moss-button--quiet moss-button--icon" type="button" data-rail-toggle aria-label="Expand navigation" aria-expanded="false" title="Expand or collapse navigation"><span class="rail-arrow" aria-hidden="true"></span></button>
        </div>

        <nav class="primary-nav" aria-label="Dashboard views">
          <button class="nav-item is-active" type="button" data-view-target="overview" data-label="Overview" aria-current="page">
            <moss-icon name="activity" class="icon"></moss-icon>
            <span data-rail-label>Overview</span>
          </button>
          <button class="nav-item" type="button" data-view-target="policies" data-label="Policies">
            <moss-icon name="document" class="icon"></moss-icon>
            <span data-rail-label>Policies</span>
          </button>
          <button class="nav-item" type="button" data-view-target="connect" data-label="Connect">
            <moss-icon name="connect" class="icon"></moss-icon>
            <span data-rail-label>Connect</span>
          </button>
        </nav>

        <div class="sidebar-meta" data-rail-label>
          <span class="eyebrow">Session</span>
          <div class="sidebar-status">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Private bearer session</span>
          </div>
          <small>Expires after 8 hours</small>
        </div>
      </moss-rail>

      <button class="sidebar-scrim" id="sidebar-scrim" type="button" aria-label="Close navigation"></button>

      <div class="workspace moss-app-main">
        <header class="topbar moss-topbar">
          <div class="topbar-title">
            <button class="icon-button mobile-menu" id="menu-button" type="button" aria-label="Open navigation" title="Open navigation">
              <moss-icon name="menu" class="icon"></moss-icon>
            </button>
            <div>
              <strong><span class="topbar-product">Bullfrog</span><span class="topbar-divider">/</span> Personal context server</strong>
              <span id="last-refreshed">Connecting...</span>
            </div>
          </div>
          <div class="topbar-actions">
            <button class="icon-button bell" id="notice-bell" type="button" aria-label="Notifications" aria-haspopup="true" aria-expanded="false" aria-controls="notice-panel" title="Notifications">
              <moss-icon name="notification" class="icon"></moss-icon>
              <span class="bell-count" id="bell-count" hidden></span>
            </button>
            <div class="notice-panel" id="notice-panel" role="dialog" aria-label="Notifications" hidden></div>
            <button class="icon-button" id="refresh-button" type="button" aria-label="Refresh dashboard" title="Refresh dashboard">
              <moss-icon name="refresh" class="icon"></moss-icon>
            </button>
            <div class="topbar-more">
              <button class="icon-button topbar-more-button" id="topbar-more-button" type="button" aria-label="More dashboard actions" aria-controls="topbar-more-panel" aria-expanded="false" title="More dashboard actions">
                <moss-icon name="overflow" class="icon"></moss-icon>
              </button>
              <div class="topbar-more-panel" id="topbar-more-panel" aria-label="Dashboard actions">
                <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false"><span class="theme-toggle-track" aria-hidden="true"><i></i></span><span data-theme-label>Dark</span></button>
                <button class="icon-button" type="button" data-copy-endpoint aria-label="Copy MCP endpoint" title="Copy MCP endpoint">
                  <moss-icon name="copy" class="icon"></moss-icon>
                </button>
                <button class="icon-button" id="logout-button" type="button" aria-label="End dashboard session" title="End dashboard session">
                  <moss-icon name="sign-out" class="icon"></moss-icon>
                </button>
              </div>
            </div>
          </div>
        </header>

        <main class="dashboard-main moss-page">
          <section class="view-panel is-active" data-view="overview" aria-labelledby="overview-title">
            <header class="overview-intro">
              <div>
                <span class="eyebrow" id="overview-date">Personal context server</span>
                <h1 id="overview-title">Good afternoon, Brandon.</h1>
                <p>Your guidance is available. See how much context it carries, whether quality held, and what needs attention.</p>
              </div>
              <span class="snapshot-date" id="snapshot-date">Evaluation pending</span>
            </header>

            <div class="service-band overview-signal moss-signal" data-tone="positive">
              <div class="service-identity moss-signal__copy">
                <span class="service-icon moss-signal__icon"><moss-icon name="service" class="icon"></moss-icon></span>
                <div>
                  <span class="service-kicker">Live service</span>
                  <span class="service-name"><span id="service-display-name">Personal Context</span> is operational</span>
                  <span class="service-summary"><span id="coverage-value">--/--</span> diagnostic phrase matches · <span id="blind-quality-value">--/--</span> recorded quality</span>
                </div>
              </div>
              <div class="service-state moss-signal__action">
                <span class="live-indicator"><span aria-hidden="true"></span> Operational</span>
                <span class="version-badge" id="service-version">v--</span>
              </div>
            </div>

            <section class="overview-section" aria-labelledby="token-footprint-title">
              <div class="overview-section-heading">
                <div><span class="eyebrow">Live picture</span><h2 id="token-footprint-title">Policy payload at a glance</h2></div>
                <span class="method-badge">JSON / o200k_base</span>
              </div>
              <div class="benchmark-module moss-narrative">
                <div class="benchmark-summary moss-narrative__summary">
                  <span class="benchmark-kicker">Context carried per request</span>
                  <div class="benchmark-number"><strong id="context-token-change">--</strong><span>serialized result tokens</span></div>
                  <p><span id="context-token-values">-- to --</span> across the policy corpus</p>
                  <div class="measurement-disclosure">
                    <strong id="guidance-text-change">-- guidance text</strong>
                    <span id="guidance-text-detail">Measurement details pending</span>
                  </div>
                </div>
                <div class="benchmark-chart">
                <div class="comparison-group">
                  <div class="comparison-heading">
                    <span>Serialized MCP result</span>
                    <strong id="context-comparison-change">--</strong>
                  </div>
                  <div class="bar-row">
                    <span id="context-baseline-label">Baseline</span>
                    <progress id="context-baseline-bar" value="0" max="100" aria-label="Baseline serialized MCP result tokens">0</progress>
                    <code id="context-baseline-value">--</code>
                  </div>
                  <div class="bar-row candidate">
                    <span>Current</span>
                    <progress id="context-candidate-bar" value="0" max="100" aria-label="Current serialized MCP result tokens">0</progress>
                    <code id="context-candidate-value">--</code>
                  </div>
                </div>

                <div class="comparison-group">
                  <div class="comparison-heading">
                    <span>Visible answer output</span>
                    <strong id="answer-comparison-change">--</strong>
                  </div>
                  <div class="bar-row">
                    <span id="answer-baseline-label">Baseline</span>
                    <progress id="answer-baseline-bar" value="0" max="100" aria-label="Baseline visible answer tokens">0</progress>
                    <code id="answer-baseline-value">--</code>
                  </div>
                  <div class="bar-row candidate">
                    <span>Current</span>
                    <progress id="answer-candidate-bar" value="0" max="100" aria-label="Current visible answer tokens">0</progress>
                    <code id="answer-candidate-value">--</code>
                  </div>
                </div>

                <div class="chart-legend">
                  <span><i class="legend-baseline"></i> Baseline</span>
                  <span><i class="legend-candidate"></i> Current policy</span>
                </div>
                </div>
              </div>
            </section>

            <div class="insight-grid">
              <section class="moss-panel quality-module insight-card" aria-labelledby="quality-title">
                <div class="moss-panel__header">
                  <div>
                    <span class="eyebrow">One-run answer sample</span>
                    <h2 id="quality-title">Recorded quality</h2>
                  </div>
                  <span class="method-badge">Directional</span>
                </div>

                <div class="moss-panel__body">
                <dl class="moss-details">
                  <div>
                    <dt>Blind judge</dt>
                    <dd><strong id="blind-judge-score">--</strong><span>both variants</span></dd>
                  </div>
                  <div>
                    <dt>Strict acceptance</dt>
                    <dd><strong id="strict-judge-score">--</strong><span id="strict-baseline-score">baseline --</span></dd>
                  </div>
                  <div>
                    <dt>Candidate outcomes</dt>
                    <dd><strong id="candidate-wins">-- wins</strong><span id="candidate-outcomes">-- losses / -- ties</span></dd>
                  </div>
                  <div>
                    <dt>Hard defects</dt>
                    <dd><strong id="hard-defects">--</strong><span>across blind review</span></dd>
                  </div>
                </dl>
                <p class="quality-caveat" id="quality-caveat">Recorded result; source transcripts were not retained.</p>
                </div>
              </section>

              <section class="moss-panel checks-module insight-card" aria-labelledby="checks-title">
                <div class="moss-panel__header">
                  <div>
                    <span class="eyebrow">Verification</span>
                    <h2 id="checks-title">Evidence set</h2>
                  </div>
                </div>
                <div class="moss-panel__body">
                <dl class="check-strip moss-reading-strip" style="--reading-count: 3">
                  <div data-priority="primary"><dt>Policy cases</dt><dd id="policy-case-count">--</dd></div>
                  <div><dt>Routing checks</dt><dd id="routing-check-count">--</dd></div>
                  <div><dt>Answer pairs</dt><dd id="answer-pair-count">--</dd></div>
                  <div><dt>Protocols</dt><dd id="protocol-count">--</dd></div>
                </dl>
                </div>
                <div class="moss-panel__footer">
                  <p class="evaluation-note" id="evaluation-note"></p>
                </div>
              </section>

              <section class="moss-panel tools-module insight-card" aria-labelledby="tools-title">
                <div class="moss-panel__header">
                  <div>
                    <span class="eyebrow">Read-only surface</span>
                    <h2 id="tools-title">Available tools</h2>
                  </div>
                  <span class="count-badge" id="tool-count">--</span>
                </div>
                <div class="moss-panel__body"><div class="tool-list" id="tool-list"></div></div>
              </section>
            </div>
            <span class="visually-hidden" id="coverage-detail">Diagnostic phrase comparison pending</span>
            <span class="visually-hidden" id="blind-quality-detail">Evaluation pending</span>
            <span class="visually-hidden" id="answer-token-change">--</span>
            <span class="visually-hidden" id="answer-token-values">-- to --</span>
            <code class="visually-hidden" id="service-endpoint">https://brandoriv.dev/mcp</code>
          </section>

          <section class="view-panel" data-view="policies" aria-labelledby="policies-title" hidden>
            <div class="section-heading">
              <div>
                <span class="eyebrow">Versioned guidance and commands</span>
                <h1 id="policies-title">Policies</h1>
              </div>
              <span class="snapshot-date"><span id="category-count">--</span> entries</span>
            </div>

            <div class="policy-browser">
              <nav class="category-nav moss-tree" id="category-nav" aria-label="Preference categories"></nav>
              <article class="policy-document moss-panel" aria-live="polite">
                <header>
                  <span class="eyebrow">Preference source</span>
                  <h2 id="policy-title">Select a category</h2>
                  <div class="policy-meta">
                    <code id="policy-id">personal://</code>
                    <span id="policy-version">v--</span>
                    <span id="policy-activation">--</span>
                    <span id="policy-reviewed">reviewed --</span>
                  </div>
                  <div class="policy-capabilities" id="policy-capabilities" hidden></div>
                </header>
                <div class="policy-content" id="policy-content"></div>
                <form class="policy-editor moss-field" id="policy-editor" hidden>
                  <label for="policy-editor-content">Policy content</label>
                  <textarea class="moss-field__control" id="policy-editor-content" rows="18" required></textarea>
                  <label for="policy-change-note">Change note</label>
                  <input class="moss-field__control" id="policy-change-note" maxlength="200" required placeholder="Why this version is better" />
                  <div><button class="moss-button" type="submit">Save new version</button><button class="moss-button moss-button--secondary" id="cancel-policy-edit" type="button">Cancel</button></div>
                </form>
                <div class="policy-actions"><button class="moss-button" id="edit-policy" type="button">Edit</button><button class="moss-button moss-button--secondary" id="policy-history" type="button">Version history</button></div>
                <div class="policy-history" id="policy-history-list" hidden></div>
              </article>
            </div>
          </section>

          <section class="view-panel" data-view="connect" aria-labelledby="connect-title" hidden>
            <div class="section-heading">
              <div>
                <span class="eyebrow">Client setup</span>
                <h1 id="connect-title">Connect</h1>
              </div>
              <span class="snapshot-date">Streamable HTTP</span>
            </div>

            <section class="connection-band" aria-label="Server connection details">
              <div>
                <span class="eyebrow">Endpoint</span>
                <code data-endpoint>https://brandoriv.dev/mcp</code>
              </div>
              <button class="moss-button moss-button--secondary" type="button" data-copy-endpoint>
                <moss-icon name="copy" class="icon"></moss-icon>
                <span>Copy endpoint</span>
              </button>
            </section>

            <section class="connection-band token-band" aria-label="Bearer token">
              <div>
                <span class="eyebrow">Bearer token</span>
                <code id="bearer-token" data-revealed="false" aria-live="polite">••••••••••••••••••••••••</code>
              </div>
              <div class="band-actions">
                <button class="moss-button moss-button--secondary" type="button" id="reveal-token-button" aria-pressed="false">
                  <moss-icon name="credential" class="icon"></moss-icon>
                  <span>Reveal</span>
                </button>
                <button class="moss-button moss-button--secondary" type="button" id="copy-token-button">
                  <moss-icon name="copy" class="icon"></moss-icon>
                  <span>Copy token</span>
                </button>
              </div>
            </section>

            <div class="connect-grid">
              <section class="moss-panel client-module" aria-labelledby="client-config-title">
                <div class="moss-panel__header">
                  <div>
                    <span class="eyebrow">Official client formats</span>
                    <h2 id="client-config-title">Configuration</h2>
                  </div>
                </div>
                <div class="moss-panel__body client-module__body">
                <div class="client-tabs moss-segmented" id="client-tabs" role="tablist" aria-label="Client configuration"></div>
                <div class="moss-code">
                  <div class="moss-code__toolbar">
                    <code id="connection-filename">--</code>
                    <div>
                      <a class="source-link" id="connection-source" href="#" target="_blank" rel="noreferrer">
                        Official docs <moss-icon name="external" class="small-icon"></moss-icon>
                      </a>
                      <button class="icon-button" id="copy-config-button" type="button" aria-label="Copy configuration" title="Copy configuration">
                        <moss-icon name="copy" class="icon"></moss-icon>
                      </button>
                    </div>
                  </div>
                  <pre class="code-block"><code id="connection-code"></code></pre>
                </div>
                </div>
              </section>

              <aside class="connection-details">
                  <section class="moss-panel" aria-labelledby="transport-title">
                  <div class="moss-panel__header">
                    <div>
                      <span class="eyebrow">Transport</span>
                      <h2 id="transport-title">Server profile</h2>
                    </div>
                  </div>
                  <div class="moss-panel__body"><dl class="moss-details">
                    <div><dt>Protocol</dt><dd id="transport-value">--</dd></div>
                    <div><dt>Authentication</dt><dd id="auth-value">--</dd></div>
                    <div><dt>Capabilities</dt><dd>Tools + resources</dd></div>
                    <div><dt>Mutations</dt><dd>None</dd></div>
                  </dl></div>
                </section>

                  <section class="moss-panel" aria-labelledby="protocols-title">
                  <div class="moss-panel__header">
                    <div>
                      <span class="eyebrow">Compatibility</span>
                      <h2 id="protocols-title">MCP versions</h2>
                    </div>
                  </div>
                  <div class="moss-panel__body"><div class="protocol-list" id="protocol-list"></div></div>
                </section>
              </aside>
            </div>
          </section>
        </main>
      </div>
    </div>

    <section class="auth-gate" id="auth-gate" aria-modal="true" role="dialog" aria-labelledby="auth-title">
      <div class="auth-story" aria-hidden="true">
        <div class="auth-orbit auth-orbit-one"></div>
        <div class="auth-orbit auth-orbit-two"></div>
        <span class="auth-story-label">Personal context, under your control.</span>
        <img src="/mcp/brandoriv-mcp-icon.png" alt="" width="360" height="360" />
        <div class="auth-story-copy">
          <span>01 / Guidance</span>
          <span>02 / Evaluation</span>
          <span>03 / Connection</span>
        </div>
      </div>
      <div class="auth-panel-wrap">
        <div class="auth-panel">
          <div class="auth-brand">
            <img src="/mcp/brandoriv-mcp-icon.png" alt="" width="42" height="42" />
            <span><strong>Bullfrog</strong><small>by brandoriv.dev</small></span>
            <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false"><span class="theme-toggle-track" aria-hidden="true"><i></i></span><span data-theme-label>Dark</span></button>
          </div>
          <span class="eyebrow">Protected workspace</span>
          <h1 id="auth-title">Welcome back,<br />Brandon.</h1>
          <p class="auth-intro">Sign in to review your live guidance, policy evaluations, and client connection details.</p>
          <a class="primary-button moss-button microsoft-button" id="microsoft-sign-in" href="/mcp/auth/login">
            <span>Sign in with Microsoft</span>
            <moss-icon name="forward" class="icon"></moss-icon>
          </a>
          <p class="auth-error" id="auth-error" role="alert"></p>
          <details class="token-fallback" id="token-fallback">
            <summary>Use the MCP bearer token instead</summary>
            <form id="auth-form" method="post">
              <label class="visually-hidden" for="username-input">Account</label>
              <input
                class="visually-hidden"
                id="username-input"
                name="username"
                type="text"
                autocomplete="username"
                value="brandon"
                tabindex="-1"
                aria-hidden="true"
              />
              <label for="token-input">MCP bearer token</label>
              <div class="token-field">
                <moss-icon name="credential" class="icon"></moss-icon>
                <input
                  class="moss-field__control"
                  id="token-input"
                  type="password"
                  autocomplete="current-password"
                  spellcheck="false"
                  required
                  maxlength="4096"
                />
              </div>
              <button class="primary-button moss-button" id="sign-in-button" type="submit">
                <span>Sign in with token</span>
                <moss-icon name="forward" class="icon"></moss-icon>
              </button>
            </form>
          </details>
          <div class="session-note">
            <moss-icon name="secure" class="icon"></moss-icon>
            <span>Sign-in exchanged for a secure, 8-hour browser session.</span>
          </div>
        </div>
      </div>
    </section>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <moss-toast-stack></moss-toast-stack>
    <noscript>This dashboard requires JavaScript.</noscript>
  </body>
</html>

---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PaperCard from "../components/PaperCard.astro";
import Polaroid from "../components/Polaroid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { profile } from "../data/profile";

const { hero } = profile;

const proof = [
  { v: "~80%", l: "of order entry" },
  { v: "15+", l: "microservices" },
  { v: "200+", l: "people served" },
  { v: "84", l: "apps upgraded" },
];

const portrait = "/photos/portrait-placeholder.svg";
---

<Layout title="Hero + about mockup · brandoriv.dev" noindex>
  <Nav />
  <main class="relative z-10 mx-auto max-w-5xl space-y-20 px-4 pb-24 pt-28 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-ink-faint">
      mockup — flashy interactive hero (move your mouse over it) · photo moved beside About
    </p>

    {/* ---------- Flashy interactive hero landing (no photo) ---------- */}
    <section class="[perspective:1100px]">
      <PaperCard
        data-tilt
        tape="brandoriv.dev"
        tapePosition="left-12"
        extraTape="left-24 -bottom-3 w-16"
        extraTapeRotate={4}
        class="tilt-card relative p-8 text-center sm:p-14 md:p-20"
      >
        <span class="hero-sheen" aria-hidden="true"></span>
        <p class="font-mono text-xs uppercase tracking-[0.28em] text-ink-faint">
          {hero.eyebrow}
        </p>
        <h1
          class="mx-auto mt-6 max-w-3xl font-display text-ink"
          style="font-size:clamp(2.5rem,7vw,5rem);line-height:1.02;"
        >
          {hero.headline.pre}<em class="hero-em">{hero.headline.emphasis}</em>{hero.headline.post}
        </h1>
        <p class="mx-auto mt-6 max-w-xl font-sans text-[17px] leading-[1.6] text-ink-soft">
          {hero.subhead}
        </p>
        <dl class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-x-8 gap-y-3">
          {
            proof.map((s) => (
              <div class="flex items-baseline gap-2">
                <dt class="font-mono text-lg font-medium tabular-nums leading-none text-ink">
                  {s.v}
                </dt>
                <dd class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-ink-faint">
                  {s.l}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-5">
          <a
            href="#"
            class="inline-block rounded-[3px] bg-ink px-7 py-3 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5"
          >
            {hero.ctaLabel}
          </a>
          <a
            href="#"
            class="inline-flex min-h-6 items-center font-mono text-sm text-ink-soft underline-reveal hover:text-ink"
          >
            or get in touch →
          </a>
        </div>
      </PaperCard>
    </section>

    {/* ---------- About, with the portrait to its left ---------- */}
    <section>
      <div class="grid items-start gap-8 md:grid-cols-[0.75fr_1.25fr]">
        {/* portrait: left of the About card (on top on mobile) */}
        <div class="order-first mx-auto w-48 sm:w-56 md:w-full md:max-w-xs">
          <Polaroid
            src={portrait}
            alt="Portrait of Brandon Rivera"
            caption="Brandon · Columbus, OH"
            rotate={-3}
            loading="eager"
            class="w-full"
          />
        </div>

        <PaperCard tape="About" tapePosition="right-10" tapeRotate={3} holes class="p-7 sm:p-10">
          <SectionHeading>
            I build the whole thing, <em>end to end</em>.
          </SectionHeading>
          <p class="mt-6 max-w-2xl font-sans text-[17px] leading-[1.6] text-ink-soft">
            {profile.summary}
          </p>
          <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-ink-soft">
            {profile.aboutExtra}
          </p>
        </PaperCard>
      </div>
    </section>
  </main>

  <style is:global>
    /* Pointer-driven 3D tilt + cursor sheen for the flashy hero card. */
    .tilt-card {
      transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform 0.3s ease;
      transform-style: preserve-3d;
      will-change: transform;
    }
    .hero-sheen {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        22rem 22rem at var(--mx, 50%) var(--my, 0%),
        rgba(255, 255, 255, 0.55),
        transparent 60%
      );
      opacity: 0;
      transition: opacity 0.35s ease;
      pointer-events: none;
    }
    [data-tilt]:hover .hero-sheen {
      opacity: 1;
    }
    /* Emphasis word: oxblood with a hand-drawn underline. */
    .hero-em {
      font-style: normal;
      color: var(--color-accent-strong);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 0.09em;
      text-underline-offset: 0.12em;
    }
    @media (prefers-reduced-motion: reduce) {
      .tilt-card {
        transform: none;
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (function () {
      var card = document.querySelector("[data-tilt]");
      if (!card) return;
      if (
        !window.matchMedia("(pointer: fine)").matches ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      )
        return;
      card.addEventListener("pointermove", function (e) {
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width;
        var py = (e.clientY - r.top) / r.height;
        card.style.setProperty("--ry", ((px - 0.5) * 9).toFixed(2) + "deg");
        card.style.setProperty("--rx", ((0.5 - py) * 6).toFixed(2) + "deg");
        card.style.setProperty("--mx", (px * 100).toFixed(1) + "%");
        card.style.setProperty("--my", (py * 100).toFixed(1) + "%");
      });
      card.addEventListener("pointerleave", function () {
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    })();
  </script>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PaperCard from "../components/PaperCard.astro";
import Polaroid from "../components/Polaroid.astro";
import { profile } from "../data/profile";

const { hero } = profile;

const proof = [
  { v: "~80%", l: "of order entry" },
  { v: "15+", l: "microservices" },
  { v: "200+", l: "people served" },
  { v: "84", l: "apps upgraded" },
];

// Swap this for a real vertical (4:5) portrait of Brandon.
const portrait = "/photos/portrait-placeholder.svg";
---

<Layout title="Hero mockup · brandoriv.dev" noindex>
  <Nav />
  <main class="relative z-10 mx-auto max-w-5xl px-4 pb-24 pt-28 sm:px-6">
    <p class="mb-6 font-mono text-xs uppercase tracking-[0.22em] text-ink-faint">
      hero mockup — photo lives on the same card (never below or off)
    </p>

    {/* One card. Desktop: intro left, portrait right. Mobile: portrait on top,
        intro below — both always inside the single hero card. */}
    <PaperCard
      tape="brandoriv.dev"
      tapePosition="left-10"
      extraTape="left-20 -bottom-3 w-16"
      extraTapeRotate={4}
      class="p-7 sm:p-10 md:p-12"
    >
      <div class="grid items-center gap-8 md:grid-cols-[1.15fr_0.85fr] md:gap-12">
        {/* intro text */}
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
            {hero.eyebrow}
          </p>
          <h1
            class="mt-5 font-display text-ink"
            style="font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;"
          >
            {hero.headline.pre}<em>{hero.headline.emphasis}</em>{hero.headline.post}
          </h1>
          <p class="mt-5 max-w-md font-sans text-[17px] leading-[1.6] text-ink-soft">
            {hero.subhead}
          </p>
          <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-3 border-t-2 border-ink/15 pt-5">
            {
              proof.map((s) => (
                <div class="flex items-baseline gap-2">
                  <dt class="font-mono text-lg font-medium tabular-nums leading-none text-ink">
                    {s.v}
                  </dt>
                  <dd class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-ink-faint">
                    {s.l}
                  </dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a
              href="#"
              class="inline-block rounded-[3px] bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5"
            >
              {hero.ctaLabel}
            </a>
            <a
              href="#"
              class="inline-flex min-h-6 items-center font-mono text-sm text-ink-soft underline-reveal hover:text-ink"
            >
              or get in touch →
            </a>
          </div>
        </div>

        {/* portrait: on top on mobile (order-first), right column on desktop */}
        <div class="order-first mx-auto w-48 sm:w-56 md:order-none md:w-full md:max-w-[18rem]">
          <Polaroid
            src={portrait}
            alt="Portrait of Brandon Rivera"
            caption="Brandon · Columbus, OH"
            rotate={-2}
            loading="eager"
            class="w-full"
          />
        </div>
      </div>
    </PaperCard>
  </main>
</Layout>

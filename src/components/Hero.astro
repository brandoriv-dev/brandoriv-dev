---
import { profile } from "../data/profile";
import PaperCard from "./PaperCard.astro";

const { hero } = profile;

// Engineer-framed proof metrics (not freelancer pricing).
const swatches = [
  { v: "~80%", l: "of order entry" },
  { v: "15+", l: "microservices" },
  { v: "200+", l: "people served" },
  { v: "84", l: "apps upgraded" },
];
---

<section id="home" class="relative">
  <PaperCard
    tape="brandoriv.dev"
    tapePosition="left-10"
    extraTape="left-20 -bottom-3 w-16"
    extraTapeRotate={4}
    class="p-6 sm:p-10 md:p-12"
  >
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-faint">
      {hero.eyebrow}
    </p>
    <h1
      class="mt-5 font-display text-ink"
      style="font-size:clamp(2.25rem,6vw,4.25rem);line-height:1.04;"
    >
      {hero.headline.pre}<em class="text-accent not-italic">{hero.headline.emphasis}</em>{hero.headline.post}
    </h1>
    <p class="mt-6 max-w-xl font-sans text-[17px] leading-[1.6] text-ink-soft">
      {hero.subhead}
    </p>

    {/* proof metrics — horizontal row, each led by an oxblood tick */}
    <dl class="mt-8 flex max-w-md flex-wrap gap-x-8 gap-y-3 border-t-2 border-ink/15 pt-5">
      {
        swatches.map((s) => (
          <div class="flex items-baseline gap-2">
            <span aria-hidden="true" class="h-3.5 w-[3px] self-center bg-accent" />
            <dt class="font-mono text-lg font-medium tabular-nums leading-none text-ink">
              {s.v}
            </dt>
            <dd class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-ink-faint">
              {s.l}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 flex flex-wrap items-center gap-5">
      <a
        href="#projects"
        class="inline-block rounded-[3px] bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5"
      >
        {hero.ctaLabel}
      </a>
      <a
        href="#contact"
        class="inline-flex min-h-6 items-center font-mono text-sm text-ink-soft underline-reveal hover:text-ink"
      >
        or get in touch →
      </a>
    </div>
  </PaperCard>
</section>

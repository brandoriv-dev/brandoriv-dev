---
// A section's serif headline. The heading text comes from the slot so callers
// can drop an <em> in for the editorial italic emphasis.
interface Props {
  class?: string;
}
const { class: extra = "" } = Astro.props;
---

<h2 class:list={["font-display text-3xl leading-tight text-ink sm:text-4xl", extra]}>
  <slot />
</h2>

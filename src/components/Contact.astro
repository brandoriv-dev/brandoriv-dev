---
import { profile } from "../data/profile";
import PaperCard from "./PaperCard.astro";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

// Web3Forms access key (free, delivers submissions straight to the inbox).
// Set PUBLIC_WEB3FORMS_KEY in .env - see README. The visible email below is the
// always-works fallback if the key isn't set or the service is down.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const redirectUrl = new URL("/thanks", Astro.site ?? profile.links.site).href;

const links: {
  label: string;
  href: string;
  text: string;
  icon: "mail" | "linkedin" | "github" | "file";
}[] = [
  { label: "Email", href: `mailto:${profile.email}`, text: profile.email, icon: "mail" },
  { label: "LinkedIn", href: profile.links.linkedin, text: "in/brandoriv", icon: "linkedin" },
  { label: "GitHub", href: profile.links.github, text: "@brandoriv", icon: "github" },
  { label: "Résumé", href: profile.resume, text: "Résumé (PDF)", icon: "file" },
];
---

<section id="contact">
  <PaperCard
    tape="Contact"
    extraTape="-left-2 bottom-16 w-12"
    extraTapeRotate={7}
    class="p-7 sm:p-10 md:p-12"
    tilt={-1.25}
    throwFrom="left"
    reveal
  >
    {/* handwritten sticky note - desktop decoration only */}
    <div
      aria-hidden="true"
      class="sticky-note absolute -right-4 -top-7 hidden rotate-6 px-4 py-3 text-sm leading-snug md:block"
      style="width:8.5rem;"
    >
      let's build something!
    </div>

    <SectionHeading>
      Have something you <em>need built</em>?
    </SectionHeading>

    <p class="mt-5 max-w-xl font-sans text-[17px] leading-[1.6] text-ink-soft">
      Tell me what you're building and I'll get back to you, usually within a day.
    </p>

    <div class="mt-8 grid gap-10 md:grid-cols-[1.4fr_1fr]">
      {/* Web3Forms - native POST + redirect, no client JS required. */}
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col gap-5"
      >
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value="New message from brandoriv.dev" />
        <input type="hidden" name="from_name" value="brandoriv.dev contact form" />
        <input type="hidden" name="redirect" value={redirectUrl} />
        {/* honeypot: bots fill this, humans never see it */}
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />

        <label class="block">
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-faint">
            Name
          </span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-1.5 w-full border-0 border-b border-line-strong bg-transparent py-2 font-sans text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-ink"
            placeholder="Your name"
          />
        </label>

        <label class="block">
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-faint">
            Email
          </span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full border-0 border-b border-line-strong bg-transparent py-2 font-sans text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-ink"
            placeholder="you@example.com"
          />
        </label>

        <label class="block">
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-faint">
            Message
          </span>
          <textarea
            name="message"
            required
            rows="5"
            class="mt-1.5 w-full resize-y border border-line-strong bg-transparent p-3 font-sans text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-ink"
            placeholder="What are you looking to build?"></textarea>
        </label>

        <div>
          <button
            type="submit"
            class="inline-block rounded-[3px] bg-ink px-6 py-3 text-sm font-medium text-paper transition-transform hover:-translate-y-0.5"
          >
            Send message
          </button>
        </div>
      </form>

      {/* always-works fallbacks */}
      <div class="md:border-l md:border-line md:pl-10">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-ink-faint">
          or reach me directly
        </p>
        <ul class="mt-4 space-y-1">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-label={l.label}
                  class="group inline-flex min-h-6 items-center gap-3 py-1 font-sans text-sm text-ink-soft transition-colors hover:text-ink"
                  {...l.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {}}
                >
                  <Icon
                    name={l.icon}
                    class="h-4 w-4 text-ink-faint transition-colors group-hover:text-accent-strong"
                  />
                  <span class="underline-reveal">{l.text}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </PaperCard>
</section>

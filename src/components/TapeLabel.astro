---
// An embossed label-maker tag (black with raised white lettering) on a card.
// Position it with utility classes (e.g. "left-8"); the look is the `.tape` class.
interface Props {
  position?: string;
  rotate?: number;
  class?: string;
}
const { position = "left-8", rotate = -2, class: extra = "" } = Astro.props;
---

<span class:list={["tape", position, extra]} style={`transform:rotate(${rotate}deg)`}>
  <slot />
</span>

---
// A full-bleed dashed "tear-away" divider with a scissors snip. The .card-bleed
// negative margins (global.css) break it out of a .card-pad card's padding so
// the line spans the whole card edge to edge; the snip position tracks the same
// scale. Decorative.
import Icon from "./Icon.astro";
---

<div class="card-bleed relative mt-10" aria-hidden="true">
  <div class="border-t-2 border-dashed border-line"></div>
  <span class="tear-snip absolute top-0 -translate-y-1/2 bg-paper px-1.5 text-ink-faint">
    <Icon name="scissors" class="h-4 w-4" />
  </span>
</div>

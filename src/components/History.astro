---
import { history, certifications } from "../data/history";
import PaperCard from "./PaperCard.astro";
import SectionHeading from "./SectionHeading.astro";
import TimelineItem from "./TimelineItem.astro";
import TearLine from "./TearLine.astro";

const work = history.filter((e) => e.kind === "work");
const education = history.filter((e) => e.kind === "education");
---

<section id="history">
  <PaperCard
    tape="Background"
    extraTape="right-10 -top-3 w-16"
    extraTapeRotate={-6}
    class="card-pad"
    throwFrom="left"
    reveal
  >
    <SectionHeading class="mb-8">
      How I <em>got here</em>.
    </SectionHeading>

    <h3 class="mb-6 font-mono text-label uppercase text-ink-faint">
      Experience
    </h3>
    <ol class="relative border-l border-line-strong">
      {work.map((entry) => <TimelineItem entry={entry} />)}
    </ol>

    <TearLine />
    <div class="pt-8">
      <h3 class="mb-6 font-mono text-label uppercase text-ink-faint">
        Education
      </h3>
      <ol class="relative border-l border-line-strong">
        {education.map((entry) => <TimelineItem entry={entry} />)}
      </ol>
    </div>

    <TearLine />
    <div class="pt-8">
      <h3 class="mb-4 font-mono text-label uppercase text-ink-faint">
        Certifications
      </h3>
      <ul class="flex flex-wrap gap-2">
        {
          certifications.map((cert) => (
            <li>
              <span class="sticker">{cert}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </PaperCard>
</section>

---
import { history, certifications } from "../data/history";
import PaperCard from "./PaperCard.astro";
import SectionHeading from "./SectionHeading.astro";
import TimelineItem from "./TimelineItem.astro";

const work = history.filter((e) => e.kind === "work");
const education = history.filter((e) => e.kind === "education");
---

<section id="history">
  <PaperCard
    tape="Background"
    edge="#4a6b82"
    extraTape="right-10 -top-3 w-16"
    extraTapeRotate={-6}
    class="p-6 sm:p-10 md:p-12"
    throwFrom="left"
    reveal
  >
    <SectionHeading class="mb-8">
      Where I've <em>been</em>.
    </SectionHeading>

    <h3 class="mb-6 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink-faint">
      Experience
    </h3>
    <ol class="relative border-l-2 border-dashed border-line-strong">
      {work.map((entry) => <TimelineItem entry={entry} />)}
    </ol>

    <div class="mt-10 border-t border-line pt-8">
      <h3 class="mb-6 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink-faint">
        Education
      </h3>
      <ol class="relative border-l-2 border-dashed border-line-strong">
        {education.map((entry) => <TimelineItem entry={entry} />)}
      </ol>
    </div>

    <div class="mt-10 border-t border-line pt-8">
      <h3 class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.18em] text-ink-faint">
        Certifications
      </h3>
      <ul class="flex flex-wrap gap-2">
        {
          certifications.map((cert) => (
            <li>
              <span class="sticker">{cert}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </PaperCard>
</section>

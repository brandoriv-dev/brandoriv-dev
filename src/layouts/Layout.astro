---
// Self-hosted fonts: Fraunces variable display (full axis set - opsz/SOFT/WONK
// give it real character), Inter body (variable), JetBrains Mono labels +
// measurements (400 + 500), Permanent Marker for tape/sticky/polaroid handwriting.
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "@fontsource-variable/inter/index.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/permanent-marker/400.css";
import "../styles/global.css";
import { profile } from "../data/profile";
import MatBackground from "../components/MatBackground.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${profile.name} · .NET & Full-Stack Developer in ${profile.location}`,
  description =
    "Columbus, OH software developer building custom web apps, REST APIs, and business software end to end. Available for web development and custom solutions.",
  ogImage = "/og-image.png",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(profile.links.site);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

// JSON-LD: a Person who offers local web/software services in Columbus.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: profile.links.site,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Columbus",
    addressRegion: "OH",
    addressCountry: "US",
  },
  sameAs: [profile.links.linkedin, profile.links.github],
  knowsAbout: [
    "Web development",
    "Custom software",
    ".NET",
    "C#",
    "REST APIs",
    "SQL",
    "Azure",
    "CI/CD",
  ],
  makesOffer: {
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: "Web development & custom software",
      areaServed: { "@type": "City", name: "Columbus, OH" },
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2c5240" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* Flag JS before first paint so reveal styles only hide content when we
        can actually animate it back in. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {/* Open Graph + Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="brandoriv.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="relative min-h-screen overflow-x-hidden text-ink antialiased">
    <a
      href="#home"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      Skip to content
    </a>

    <MatBackground />

    <slot />

    <script>
      // Reveal [data-reveal] elements as they scroll into view (one-shot).
      const reveal = () => {
        const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

        if (reduce.matches || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
        );

        items.forEach((el) => observer.observe(el));
      };

      reveal();
    </script>

    <script is:inline>
      // Subtle parallax: drift the mat photo as you scroll. rAF-throttled,
      // bounded, and skipped entirely under prefers-reduced-motion.
      (function () {
        var mat = document.getElementById("mat-photo");
        if (!mat) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var MAX = 80;
        var ticking = false;
        function update() {
          var doc = document.documentElement;
          var scrollable = doc.scrollHeight - window.innerHeight || 1;
          var progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
          mat.style.transform = "translate3d(0," + progress * MAX + "px,0)";
          ticking = false;
        }
        function onScroll() {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(update);
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
